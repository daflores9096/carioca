# Copiar a .env.prod y ajustar valores reales.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

CARIOCA_PORT=48080

# URL pública exacta (LAN o HTTPS del reverse proxy Synology)
CORS_ORIGIN=https://carioca.tudominio.com

# Vacío = automático según CORS_ORIGIN (https → cookie Secure)
# Forzar: 1 si solo HTTPS, 0 si también entrás por http://IP:48080
SESSION_COOKIE_SECURE=

SESSION_NAME=CARIOCASESSID

DB_NAME=carioca
DB_USER=root
# Si la BD ya existe con otra clave (p. ej. root), usá esa o recreá el volumen
DB_PASS=cambiame_por_una_clave_segura
