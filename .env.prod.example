# Copiar a .env.prod y ajustar valores reales.
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

CARIOCA_PORT=48080

# URL pública exacta con la que entrás al navegador.
# Tailscale (recomendado si book-readings ya usa *.ts.net):
#   CORS_ORIGIN=https://dflores.tail134d69.ts.net:8443
#   APP_URL=https://dflores.tail134d69.ts.net:8443
# Reverse proxy Synology / dominio propio:
#   CORS_ORIGIN=https://carioca.tudominio.com
#   APP_URL=https://carioca.tudominio.com
CORS_ORIGIN=https://dflores.tail134d69.ts.net:8443
APP_URL=https://dflores.tail134d69.ts.net:8443

# Vacío = automático según CORS_ORIGIN (https → cookie Secure)
# Con Tailscale HTTPS dejalo vacío o en 1
SESSION_COOKIE_SECURE=

SESSION_NAME=CARIOCASESSID

DB_NAME=carioca
DB_USER=root
# Si la BD ya existe con otra clave (p. ej. root), usá esa o recreá el volumen
DB_PASS=cambiame_por_una_clave_segura

# SMTP obligatorio en producción para "Olvidaste tu contraseña?"
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_FROM=noreply@tudominio.com
MAIL_FROM_NAME=CARIOCA
