DB_HOST=db
DB_PORT=3306
DB_NAME=carioca
DB_USER=root
DB_PASS=root
APP_ENV=development
APP_DEBUG=1
CORS_ORIGIN=http://localhost:48080
APP_URL=http://localhost:48080
SESSION_NAME=CARIOCASESSID
# Vacío = automático (https en CORS_ORIGIN → Secure). Solo hace falta en producción.
SESSION_COOKIE_SECURE=

# SMTP (recuperación de contraseña). En desarrollo sin SMTP se devuelve el enlace en la respuesta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME=CARIOCA
